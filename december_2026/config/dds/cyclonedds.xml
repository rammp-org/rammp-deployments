<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mounted into every docker node in sheppy-manifest.yaml, with CYCLONEDDS_URI
  pointing at it. rammp-base's docker/cyclonedds.xml as of
  rammp-org/RAMMP-docker#12 as merged (AllowMulticast spdp, ParticipantIndex
  none), with one change only the deployment can make: the network interfaces
  are named (see below). Several images pinned here are still built on a
  rammp-base without #12: their file multicasts user data and caps a host at 10
  participants, which the flatbot profile alone fills. Once every pinned image
  is built on a rammp-base that includes #12 the rest of this file matches the
  image's, but the file and the mounts stay: an image cannot know this robot's
  interface names.
-->
<!--
  Default Cyclone DDS configuration for RAMMP containers.

  Installing ros-humble-rmw-cyclonedds-cpp is not enough to actually use
  Cyclone: without RMW_IMPLEMENTATION set, ROS 2 silently falls back to Fast
  DDS. The base image sets both RMW_IMPLEMENTATION and CYCLONEDDS_URI so every
  module inherits a consistent, working middleware.

  The interfaces are named, not autodetermined: eno1 is the base's network
  (the MIB and the wheels), enp3s0 the arm's. autodetermine picks one NIC, and
  on snorlax that is enp3s0 whenever the arm's network is up, so a node never
  sees the MIB: no /base/odom and no odom -> base_link in /tf (measured
  2026-11-16 with this file: 0 messages, against 19 Hz once eno1 is named).
  Both are presence_required="false" so the stack still starts with the arm or
  the base unplugged; a named interface that is down is otherwise a fatal
  error, and with neither present a node fails to start. Run containers with
  `--network host` so these are the robot's real NICs; on a Docker bridge
  network neither exists.

  Override for a specific robot or bench setup by mounting your own file and
  pointing CYCLONEDDS_URI at it:
      docker run -e CYCLONEDDS_URI=file:///cfg/my.xml -v ./my.xml:/cfg/my.xml ...
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="eno1" presence_required="false" />
        <NetworkInterface name="enp3s0" presence_required="false" />
      </Interfaces>
      <!--
        spdp: multicast for participant discovery only; user data goes
        unicast. With "default", any topic with more than one reader is
        multicast onto the selected NIC. On a robot that NIC is usually the
        arm's network, and camera images multicast there (~39 MB/s measured)
        starve the Kinova's 1 kHz cyclic UDP channel until BaseCyclic Refresh
        times out. Unicast between processes on the same host never leaves
        the machine.
      -->
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <!--
        none: each participant binds OS-assigned ports and advertises them in
        its multicast discovery announcements, so there is no per-host cap.
        "auto" gives each participant a fixed port slot and Cyclone's default
        caps those at 10 per host per domain. Every process in every
        --network host container counts, so a full robot stack runs out and
        the next node fails with "Failed to find a free participant index".
        Fixed slots only matter for unicast discovery through a <Peers> list,
        which RAMMP does not use.
      -->
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
